user_version=5
index|idx_adr_sync_block|adr_sync_records|CREATE UNIQUE INDEX idx_adr_sync_block ON adr_sync_records(project, provider, block_key)
index|idx_adr_sync_memory|adr_sync_records|CREATE UNIQUE INDEX idx_adr_sync_memory ON adr_sync_records(project, memory_id) WHERE memory_id IS NOT NULL
index|idx_code_edges_from|code_edges|CREATE INDEX idx_code_edges_from ON code_edges(from_id)
index|idx_code_edges_src_file|code_edges|CREATE INDEX idx_code_edges_src_file ON code_edges(src_file_id)
index|idx_code_edges_to|code_edges|CREATE INDEX idx_code_edges_to ON code_edges(to_id)
index|idx_code_files_project|code_files|CREATE INDEX idx_code_files_project ON code_files(project)
index|idx_code_nodes_file|code_nodes|CREATE INDEX idx_code_nodes_file ON code_nodes(file_id)
index|idx_code_nodes_project_name|code_nodes|CREATE INDEX idx_code_nodes_project_name ON code_nodes(project, name)
index|idx_compression_originals_access|compression_originals|CREATE INDEX idx_compression_originals_access ON compression_originals(last_access_at)
index|idx_compression_originals_expires|compression_originals|CREATE INDEX idx_compression_originals_expires ON compression_originals(expires_at)
index|idx_consensus_review|consensus_findings|CREATE INDEX idx_consensus_review ON consensus_findings(review_id)
index|idx_hcd_evidence_unit|hcd_evidence|CREATE INDEX idx_hcd_evidence_unit ON hcd_evidence(project, unit_id, created_at)
index|idx_hcd_units_active|hcd_units|CREATE INDEX idx_hcd_units_active ON hcd_units(project, active)
index|idx_memories_created|memories|CREATE INDEX idx_memories_created ON memories(created_at DESC)
index|idx_memories_project|memories|CREATE INDEX idx_memories_project ON memories(project)
index|idx_memories_project_session|memories|CREATE INDEX idx_memories_project_session ON memories(project, session_id, created_at)
index|idx_memories_topic|memories|CREATE INDEX idx_memories_topic ON memories(project, topic_key) WHERE topic_key IS NOT NULL
index|idx_memories_type|memories|CREATE INDEX idx_memories_type ON memories(type)
index|idx_octopus_project_class|octopus_executions|CREATE INDEX idx_octopus_project_class ON octopus_executions(project, task_class)
index|idx_octopus_project_task|octopus_executions|CREATE INDEX idx_octopus_project_task ON octopus_executions(project, task_id)
index|idx_rejudgments_finding|rejudgments|CREATE INDEX idx_rejudgments_finding ON rejudgments(consensus_finding_id)
index|idx_relations_mem_a|memory_relations|CREATE INDEX idx_relations_mem_a ON memory_relations(memory_id_a)
index|idx_relations_mem_b|memory_relations|CREATE INDEX idx_relations_mem_b ON memory_relations(memory_id_b)
index|idx_relations_pair|memory_relations|CREATE UNIQUE INDEX idx_relations_pair ON memory_relations(project, memory_id_a, memory_id_b)
index|idx_relations_project|memory_relations|CREATE INDEX idx_relations_project ON memory_relations(project)
index|idx_reviews_project|reviews|CREATE INDEX idx_reviews_project ON reviews(project)
index|idx_reviews_status|reviews|CREATE INDEX idx_reviews_status ON reviews(project, status)
index|idx_sessions_project_created|sessions|CREATE INDEX idx_sessions_project_created ON sessions(project, created_at)
index|idx_socratica_dispatch|socratica_flows|CREATE UNIQUE INDEX idx_socratica_dispatch ON socratica_flows(dispatch_id) WHERE dispatch_id IS NOT NULL
index|idx_socratica_flows_scope|socratica_flows|CREATE INDEX idx_socratica_flows_scope ON socratica_flows(project, client, updated_at)
index|idx_socratica_history_scope|socratica_history|CREATE INDEX idx_socratica_history_scope ON socratica_history(project, client, completed_at DESC)
index|idx_socratica_one_pending|socratica_flows|CREATE UNIQUE INDEX idx_socratica_one_pending ON socratica_flows(project, client) WHERE phase NOT IN ('dispatched','cancelled')
