+ "aaf5312676b94b034a6923b0e01dddb9b091c7035eee54d6fd75b5f7298d807e",
+ },
 },
 {
 Alias: "constitution",
@@ -61,6 +102,15 @@ var PinnedDocs = []PinnedDoc{
